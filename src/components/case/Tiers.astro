---
/**
 * Graded items such as triage levels or root-cause layers.
 * `level` (1-3) renders as a severity scale; the highest level gets the accent.
 */
interface Item {
  kicker: string;
  title: string;
  body: string;
  level?: 1 | 2 | 3;
  meta?: string;
}
interface Props {
  items: Item[];
  cols?: 2 | 3 | 4;
  scaleLabel?: string;
}
const { items, cols = 3, scaleLabel = 'Severity' } = Astro.props;
const grid = { 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 xl:grid-cols-4' }[cols];
---

<div class:list={['case-block grid gap-px border border-line bg-line', grid]} data-reveal>
  {
    items.map((it, i) => (
      <div class="tier flex flex-col bg-surface p-5 sm:p-6" style={`--k:${i}`}>
        <div class="flex items-center justify-between gap-4">
          <span class="label">{it.kicker}</span>
          {it.level && (
            <span class="flex items-center gap-1" role="img" aria-label={`${scaleLabel} ${it.level} of 3`}>
              {[1, 2, 3].map((n) => (
                <span
                  class:list={[
                    'h-2 w-4',
                    n <= it.level! ? (it.level === 3 ? 'bg-accent' : 'bg-ink') : 'bg-line-strong/60',
                  ]}
                />
              ))}
            </span>
          )}
        </div>
        <p class="mt-4 font-display text-xl leading-tight font-semibold tracking-[-0.02em]">{it.title}</p>
        <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-2">{it.body}</p>
        {it.meta && <p class="mt-4 border-t border-line pt-3 font-mono text-xs text-muted">{it.meta}</p>}
      </div>
    ))
  }
</div>
