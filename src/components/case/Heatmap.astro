---
/**
 * Matrix of rates. Cell tint scales with value in the accent colour; every value is also printed,
 * so meaning never depends on colour alone.
 */
interface Props {
  rows: string[];
  cols: string[];
  values: (number | null)[][];
  max: number;
  suffix?: string;
  decimals?: number;
  caption: string;
  rowHeader?: string;
  threshold?: number;
}
const { rows, cols, values, max, suffix = '%', decimals = 1, caption, rowHeader = '', threshold } = Astro.props;
const tint = (v: number) => Math.round(Math.min(1, v / max) * 72);
---

<div class="case-block scroll-x overflow-x-auto" data-reveal>
  <table class="w-full min-w-[34rem] border-separate border-spacing-[3px] text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="label py-2 pr-3 text-left font-normal">{rowHeader}</th>
        {cols.map((c) => <th scope="col" class="label py-2 text-center font-normal">{c}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r, ri) => (
          <tr>
            <th scope="row" class="py-1 pr-3 text-left font-normal whitespace-nowrap text-ink-2">
              {r}
            </th>
            {values[ri].map((v) =>
              v === null ? (
                <td class="bg-surface-2/60 py-2.5 text-center text-xs text-muted">n/a</td>
              ) : (
                <td
                  class:list={[
                    'num py-2.5 text-center text-xs',
                    threshold !== undefined && v >= threshold ? 'font-semibold text-ink' : 'text-ink-2',
                  ]}
                  style={`background: color-mix(in oklab, var(--accent) ${tint(v)}%, var(--surface))`}
                >
                  {v.toFixed(decimals)}
                  {suffix}
                </td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
