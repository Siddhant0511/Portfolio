---
import { Image } from 'astro:assets';
import { ArrowDownRightIcon, ArrowRightIcon } from '@phosphor-icons/react';
import portrait from '@/assets/portrait/siddhant.jpg';
import { Magnetic } from '@/components/ui/magnetic';
import { site } from '@/lib/site';

const titleBlock = [
  { k: 'Program', v: 'PGDM, Analytics & Ops' },
  { k: 'Institute', v: 'Great Lakes Institute of Management, Gurgaon' },
  { k: 'Trained as', v: 'Architect, B.Arch 2024' },
  { k: 'Last role', v: 'Ashok Leyland, Analytics & Ops' },
];
---

<section class="relative" aria-labelledby="hero-title">
  <div class="container-x grid gap-12 pt-10 pb-16 md:pt-14 lg:grid-cols-12 lg:gap-10 lg:pt-16 lg:pb-20">
    <div class="flex flex-col lg:col-span-7 lg:justify-center">
      <p class="hero-in label" style="--d: 0ms">
        {site.program} <span class="text-line-strong">/</span> Great Lakes Institute of Management <span class="text-line-strong">/</span> Batch {site.batch}
      </p>

      <h1
        id="hero-title"
        class="mt-6 font-display text-[clamp(3.5rem,11.5vw,9.5rem)] leading-[0.92] font-bold tracking-[-0.035em]"
      >
        <span class="hero-line"><span style="--d: 60ms">Siddhant</span></span>
        <span class="hero-line"><span style="--d: 160ms">Morye<span class="text-accent">.</span></span></span>
      </h1>

      <p class="hero-in mt-8 max-w-[34ch] text-lg leading-snug text-ink-2 md:text-xl" style="--d: 320ms">
        Architect turned analyst. I build data pipelines, dashboards and shop-floor tools that turn messy operations
        into systems people use.
      </p>

      <div class="hero-in mt-10 flex flex-wrap items-center gap-3" style="--d: 440ms">
        <Magnetic client:visible intensity={0.25} range={120}>
          <a
            href="#work"
            class="group inline-flex h-12 items-center gap-3 bg-ink pr-4 pl-5 text-[15px] font-medium text-bg transition-colors duration-300 hover:bg-accent-ink active:translate-y-px"
          >
            See the work
            <ArrowDownRightIcon className="size-4 transition-transform duration-300 group-hover:rotate-[-45deg]" aria-hidden="true" />
          </a>
        </Magnetic>
        <a
          href="#contact"
          class="group inline-flex h-12 items-center gap-2 border border-line-strong px-5 text-[15px] font-medium transition-colors hover:border-ink active:translate-y-px"
        >
          Contact
          <ArrowRightIcon className="size-4 transition-transform duration-300 group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>

    <!-- From lg up the sheet fills the grid row, and the portrait takes whatever height is
         left once the title block is placed, so the two columns end on the same line. -->
    <figure class="hero-in relative mx-auto flex w-full max-w-md flex-col lg:col-span-5 lg:max-w-none" style="--d: 200ms">
      <div class="sheet relative flex flex-1 flex-col border border-line bg-surface p-2.5 sm:p-3">
        <div class="photo-wipe relative aspect-[4/5] overflow-hidden bg-surface-2 lg:aspect-auto lg:min-h-0 lg:flex-1">
          <Image
            src={portrait}
            alt="Portrait of Siddhant Morye in a dark suit, standing outside a glass-fronted building"
            widths={[420, 640, 880, 1100]}
            sizes="(min-width: 1024px) 38vw, (min-width: 640px) 28rem, 92vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-[50%_18%]"
          />
        </div>
        <dl class="mt-2.5 grid grid-cols-2 border-t border-line sm:mt-3">
          {
            titleBlock.map((row, i) => (
              <div class:list={['px-1 pt-3 pb-1', i % 2 === 1 && 'border-l border-line pl-3', i > 1 && 'border-t border-line']}>
                <dt class="label">{row.k}</dt>
                <dd class="mt-1 text-[13px] leading-tight font-medium sm:text-sm">{row.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </figure>
  </div>
</section>

<style>
  /* Registration marks at the corners of the portrait sheet, borrowed from drawing sheets. */
  .sheet::before,
  .sheet::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    pointer-events: none;
  }
  .sheet::before {
    top: -5px;
    left: -5px;
    border-top: 1.5px solid;
    border-left: 1.5px solid;
  }
  .sheet::after {
    right: -5px;
    bottom: -5px;
    border-right: 1.5px solid;
    border-bottom: 1.5px solid;
  }

  /* The reveal mask needs room for descenders at this tight leading, so the box is
     padded and the padding is pulled back out again to keep the leading unchanged. */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.24em;
    margin-bottom: -0.24em;
  }
  .hero-line > span {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The portrait uncovers itself, then settles out of a slow push-in. */
    .photo-wipe {
      animation: wipe 1100ms cubic-bezier(0.16, 1, 0.3, 1) 260ms both;
    }
    .photo-wipe img {
      animation: settle 1600ms cubic-bezier(0.16, 1, 0.3, 1) 260ms both;
    }

    .hero-line > span {
      animation: rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .hero-in {
      animation: fade-up 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0ms);
    }
  }

  @keyframes rise {
    from { transform: translateY(calc(100% + 0.28em)); }
    to { transform: translateY(0); }
  }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes wipe {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes settle {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
</style>
