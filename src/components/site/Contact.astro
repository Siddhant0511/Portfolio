---
import { ArrowUpRightIcon, CheckIcon, CopyIcon, LinkedinLogoIcon } from '@phosphor-icons/react';
import { site } from '@/lib/site';
import { url } from '@/lib/utils';
---

<section id="contact" data-theme="dark" class="relative overflow-hidden border-t border-line bg-bg py-20 text-ink sm:py-28" aria-labelledby="contact-title">
  <div class="container-x">
    <p class="label" data-reveal>Contact</p>
    <h2
      id="contact-title"
      class="mt-6 max-w-[16ch] font-display text-[clamp(3rem,9vw,7.5rem)] leading-[0.95] font-bold tracking-[-0.035em]"
    >
      <span data-mask><span>Have a messy</span></span>
      <span data-mask class="optical-p"><span style="--mask-i:1">process?</span></span>
      <span data-mask><span class="text-accent" style="--mask-i:2">Let’s talk.</span></span>
    </h2>

    <div class="mt-14 grid gap-8 border-t border-line pt-8 lg:grid-cols-12" data-reveal style="--reveal-i:2">
      <div class="lg:col-span-7">
        <p class="text-sm text-muted">Email is the fastest way to reach me</p>
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <a
            href={`mailto:${site.email}`}
            class="font-display text-[clamp(1.4rem,3.6vw,2.6rem)] leading-tight font-medium tracking-[-0.03em] break-all decoration-accent decoration-2 underline-offset-8 hover:underline"
          >
            {site.email}
          </a>
          <button
            type="button"
            data-copy={site.email}
            class="inline-flex h-10 cursor-pointer items-center gap-2 border border-line-strong px-3 text-sm text-ink-2 transition-colors hover:border-ink hover:text-ink"
          >
            <CopyIcon className="size-4" data-copy-icon aria-hidden="true" />
            <CheckIcon className="hidden size-4 text-accent" data-check-icon aria-hidden="true" />
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>
      <div class="flex flex-col gap-3 lg:col-span-4 lg:col-start-9">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          class="group flex items-center justify-between border border-line-strong px-5 py-4 transition-colors hover:border-ink"
        >
          <span class="flex items-center gap-3"><LinkedinLogoIcon className="size-5" aria-hidden="true" /> LinkedIn</span>
          <ArrowUpRightIcon className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
        </a>
        {
          site.resume && (
            <a
              href={url(`/${site.resume}`)}
              class="group flex items-center justify-between border border-line-strong px-5 py-4 transition-colors hover:border-ink"
            >
              Résumé (PDF)
              <ArrowUpRightIcon className="size-4" aria-hidden="true" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  function setupCopy() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', async () => {
        const label = btn.querySelector('[data-copy-label]');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          btn.querySelector('[data-copy-icon]')?.classList.add('hidden');
          btn.querySelector('[data-check-icon]')?.classList.remove('hidden');
          if (label) label.textContent = 'Copied';
          setTimeout(() => {
            btn.querySelector('[data-copy-icon]')?.classList.remove('hidden');
            btn.querySelector('[data-check-icon]')?.classList.add('hidden');
            if (label) label.textContent = 'Copy';
          }, 2000);
        } catch {
          if (label) label.textContent = 'Press Ctrl+C';
        }
      });
    });
  }
  document.addEventListener('astro:page-load', setupCopy);
</script>

<style>
  /* Satoshi gives lowercase p a smaller left side bearing than H and L, so the stem of
     "process?" sat about 2px left of the lines above and below it at the display size.
     0.0156em is the measured difference, so it scales with the clamped font size. */
  .optical-p {
    text-indent: 0.0156em;
  }
</style>
