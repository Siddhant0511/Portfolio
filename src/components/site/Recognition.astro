---
import { awards, positions } from '@/lib/site';

const groups = [
  { title: 'Awards', items: awards },
  { title: 'Leadership and volunteering', items: positions },
];
---

<section class="border-t border-line py-20 sm:py-28" aria-labelledby="recognition-title">
  <div class="container-x">
    <h2 id="recognition-title" class="text-5xl tracking-[-0.04em] sm:text-6xl" data-mask><span>Beyond the classroom</span></h2>
    <div class="mt-12 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {
        groups.map((g, gi) => (
          <div data-reveal style={`--reveal-i:${gi}`}>
            <h3 class="font-sans text-sm font-medium tracking-normal text-muted">{g.title}</h3>
            <ul class="mt-3">
              {g.items.map((a) => (
                <li class="grid grid-cols-[1fr_auto] gap-x-6 border-t border-line py-4">
                  <span class="font-medium leading-snug">{a.title}</span>
                  <span class="num row-span-2 text-sm text-muted">{a.year}</span>
                  <span class="mt-1 text-sm text-ink-2">{a.where}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
