---
import { Marquee } from '@/components/ui/marquee';
import { capabilities, education, tools } from '@/lib/site';
---

<section id="about" class="border-t border-line bg-surface pt-20 sm:pt-28" aria-labelledby="about-title">
  <div class="container-x">
    <h2 id="about-title" class="sr-only">About</h2>
    <p
      class="max-w-[22ch] font-display text-[clamp(2.25rem,5.5vw,4.75rem)] leading-[1] font-semibold tracking-[-0.035em] text-balance"
      data-reveal
    >
      Architecture taught me to draw the whole system <span class="text-muted">before touching one part of it.</span>
    </p>

    <div class="mt-14 grid gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-10">
      <div class="space-y-5 text-[17px] leading-relaxed text-ink-2 lg:col-span-5" data-reveal>
        <p>
          I spent five years training as an architect, where every drawing had to account for structure, services,
          people and cost at once. That habit carried straight into management school.
        </p>
        <p>
          Now I work on the operational side: cleaning data nobody else could open, finding the one variable that
          explains a problem, and building the small tool or dashboard that makes the fix stick. When a process
          lives in paper registers, I would rather redesign it than report on it.
        </p>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <dl class="grid gap-px border border-line bg-line sm:grid-cols-3">
          {
            capabilities.map((c, i) => (
              <div class="bg-surface p-5" data-reveal style={`--reveal-i:${i}`}>
                <dt class="label !text-ink">{c.name}</dt>
                <dd class="mt-4">
                  <ul class="grid gap-2 text-sm leading-snug text-ink-2">
                    {c.items.map((it) => (
                      <li>{it}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10" data-reveal>
          <h3 class="font-sans text-sm font-medium tracking-normal text-muted">Academic record</h3>
          <table class="mt-3 w-full text-left text-sm">
            <caption class="sr-only">Degrees, institutes, scores and years</caption>
            <thead class="sr-only">
              <tr><th scope="col">Qualification</th><th scope="col">Institute</th><th scope="col">Score</th><th scope="col">Year</th></tr>
            </thead>
            <tbody>
              {
                education.map((e) => (
                  <tr class="border-t border-line">
                    <th scope="row" class="py-3 pr-4 align-top font-medium whitespace-nowrap">{e.degree}</th>
                    <td class="hidden py-3 pr-4 align-top text-ink-2 sm:table-cell">{e.school}</td>
                    <td class="num py-3 pr-4 text-right align-top whitespace-nowrap text-ink-2">{e.score}</td>
                    <td class="num py-3 text-right align-top text-muted">{e.year}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-20 border-t border-line bg-bg py-2 sm:mt-28" aria-label="Tools I use">
    <Marquee className="[--duration:48s] [--gap:0rem]" pauseOnHover repeat={3}>
      {
        tools.map((t) => (
          <span class="flex items-center font-display text-2xl font-medium tracking-[-0.03em] whitespace-nowrap text-ink-2 sm:text-3xl">
            <span class="px-6 sm:px-8">{t}</span>
            <span class="size-1.5 rotate-45 bg-accent" aria-hidden="true" />
          </span>
        ))
      }
    </Marquee>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    :global(.animate-marquee) {
      animation: none !important;
    }
  }
</style>
