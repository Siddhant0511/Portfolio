---
import MetricValue from '@/components/case/MetricValue.astro';

interface Props {
  caseCount: number;
}
const { caseCount } = Astro.props;

const stats = [
  { value: 1052714, label: 'attendance rows engineered from 2,530 vendor files', source: 'Ashok Leyland' },
  { value: 855969, label: 'loan records profiled for credit risk', source: 'Crest Finception' },
  { value: 4, label: 'plant systems designed in one summer', source: 'Ashok Leyland' },
  { value: caseCount, label: 'case files across ops, analytics, fintech and ERP', source: 'Internship, competitions, coursework' },
];
---

<section aria-label="At a glance" class="border-y border-line bg-surface">
  <div class="container-x">
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {
        stats.map((s, i) => (
          <div
            data-reveal
            style={`--reveal-i:${i}`}
            class:list={[
              'flex flex-col justify-start gap-4 py-7 sm:justify-between sm:gap-6 sm:py-9',
              i % 2 === 1 ? 'border-l border-line pl-4 sm:pl-6' : 'pr-4 sm:pr-6',
              i > 1 && 'border-t border-line lg:border-t-0',
              i === 2 && 'lg:border-l lg:pl-6',
              i > 0 && 'lg:pl-6',
            ]}
          >
            <dt class="order-2 text-sm leading-snug text-ink-2">
              {s.label}
              <span class="label mt-2 block">{s.source}</span>
            </dt>
            <dd class="order-1 font-display text-[clamp(1.75rem,4.2vw,3.25rem)] leading-none font-semibold tracking-[-0.04em] [font-variation-settings:'opsz'_96]">
              <MetricValue value={s.value} />
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
