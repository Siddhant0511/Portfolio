---
import { Image } from 'astro:assets';
import { ArrowUpRightIcon } from '@phosphor-icons/react';
import type { Work } from '@/lib/work';
import { workHref } from '@/lib/work';
import MetricValue from '@/components/case/MetricValue.astro';
import screenLanguage from '@/assets/work/grievance-platform/screen-language.jpg';
import screenHome from '@/assets/work/grievance-platform/screen-home.jpg';
import screenForm from '@/assets/work/grievance-platform/screen-form.jpg';
import tyre1 from '@/assets/work/al-tics/tyre-1.jpg';
import tyre2 from '@/assets/work/al-tics/tyre-2.jpg';
import tyre3 from '@/assets/work/al-tics/tyre-3.jpg';

interface Props {
  items: Work[];
}
const { items } = Astro.props;
const byId = Object.fromEntries(items.map((w) => [w.id, w]));
const order = ['grievance-platform', 'contractor-absenteeism', 'time-office', 'al-tics'];
const layout: Record<string, string> = {
  'grievance-platform': 'lg:col-span-7',
  'contractor-absenteeism': 'lg:col-span-5',
  'time-office': 'lg:col-span-5',
  'al-tics': 'lg:col-span-7',
};

// Absenteeism by tenure bucket, from the SIP report (Figure 2.1)
const tenure = [
  { label: '0-3 mo', v: 54.0 },
  { label: '3-6 mo', v: 25.5 },
  { label: '6-12 mo', v: 18.9 },
  { label: '1-2 yr', v: 23.2 },
  { label: '2-5 yr', v: 24.4 },
];
const syncSteps = ['ZKTeco', 'WDMS', 'Firewall', 'CLMS'];
---

<div class="grid gap-3 sm:gap-4 lg:grid-cols-12">
  {
    order.map((id, i) => {
      const w = byId[id];
      if (!w) return null;
      const m = w.data.metrics[0];
      return (
        <a
          href={workHref(w)}
          data-reveal
          style={`--reveal-i:${i}`}
          class:list={[
            'feat group relative flex flex-col overflow-hidden border border-line bg-surface transition-[border-color,transform,box-shadow] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:border-line-strong',
            layout[id],
          ]}
        >
          <div class="flex items-start justify-between gap-4 p-5 sm:p-6">
            <div class="max-w-md">
              <p class="label">
                <span class="text-accent-ink">{w.data.fileId}</span>
              </p>
              <h3
                class="mt-3 text-2xl tracking-[-0.03em] transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 motion-reduce:transition-none sm:text-[1.75rem]"
                transition:name={`title-${w.id}`}
              >
                {w.data.title}
              </h3>
              <p class="mt-2 text-[15px] leading-snug text-ink-2">{w.data.problem}</p>
            </div>
            <span class="grid size-10 shrink-0 place-items-center border border-line transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-white">
              <ArrowUpRightIcon className="size-4" aria-hidden="true" />
            </span>
          </div>

          <div class="relative mt-auto h-64 overflow-hidden sm:h-72" aria-hidden="true">
            {id === 'grievance-platform' && (
              <div class="absolute inset-0 flex justify-center gap-3 bg-surface-2 px-6 sm:gap-5">
                {[screenLanguage, screenHome, screenForm].map((src, k) => (
                  <Image
                    src={src}
                    alt=""
                    widths={[200, 360]}
                    sizes="(min-width: 1024px) 11rem, 28vw"
                    style={`--p:${k}; --r:${(k - 1) * 2.5}deg`}
                    class:list={[
                      'phone h-auto w-[28%] max-w-[11rem] self-start border border-line bg-white shadow-[0_24px_48px_-24px_rgb(var(--shadow-tint)/0.4)]',
                      k === 1 ? 'mt-5' : 'mt-10',
                    ]}
                  />
                ))}
              </div>
            )}

            {id === 'contractor-absenteeism' && (
              <div class="absolute inset-0 flex flex-col justify-end px-5 pb-6 sm:px-6">
                <div class="flex h-40 items-end gap-2 sm:gap-3">
                  {tenure.map((t, k) => (
                    <div class="flex h-full flex-1 flex-col items-center justify-end gap-2">
                      <span class:list={['num text-xs', k === 0 ? 'text-accent-ink' : 'text-muted']}>{t.v.toFixed(1)}%</span>
                      <span
                        class:list={['bar w-full origin-bottom', k === 0 ? 'bg-accent' : 'bg-line-strong']}
                        style={`height:${(t.v / 54) * 100}%; --k:${k}`}
                      />
                    </div>
                  ))}
                </div>
                <div class="mt-2 flex gap-2 border-t border-line pt-2 sm:gap-3">
                  {tenure.map((t) => (
                    <span class="label flex-1 text-center !text-[10px] !tracking-normal">{t.label}</span>
                  ))}
                </div>
              </div>
            )}

            {id === 'time-office' && (
              <div class="absolute inset-0 flex flex-col justify-end gap-8 px-5 pb-6 sm:px-6">
                <div>
                  <div class="relative flex h-20 items-end gap-[3px]">
                    <span class="num absolute top-0 right-[16.1%] text-[11px] whitespace-nowrap text-accent-ink">25-26, payroll close</span>
                    {Array.from({ length: 31 }, (_, d) => {
                      const hot = d === 24 || d === 25;
                      return (
                        <span class="relative flex flex-1 flex-col items-center justify-end">
                          <span
                            class:list={['tick w-full origin-bottom', hot ? 'h-12 bg-accent' : 'h-5 bg-line-strong']}
                            style={`--k:${d}`}
                          />
                        </span>
                      );
                    })}
                  </div>
                  <div class="relative mt-2 flex justify-between border-t border-line pt-2">
                    <span class="label !text-[10px]">Day 1</span>
                    <span class="label !text-[10px]">Day 31</span>
                  </div>
                </div>
                <div class="flex items-center">
                  {syncSteps.map((step, k) => (
                    <>
                      <span class="border border-line-strong bg-bg px-2 py-1.5 font-mono text-[11px] whitespace-nowrap">{step}</span>
                      {k < syncSteps.length - 1 && (
                        <span class="relative mx-1 h-px flex-1 bg-line-strong">
                          <span class="absolute top-1/2 left-1/2 size-2 -translate-1/2 rotate-45 bg-accent" />
                        </span>
                      )}
                    </>
                  ))}
                </div>
              </div>
            )}

            {id === 'al-tics' && (
              <div class="absolute inset-0 grid grid-cols-3 gap-px bg-line">
                {[tyre1, tyre2, tyre3].map((src) => (
                  <div class="relative overflow-hidden">
                    <Image
                      src={src}
                      alt=""
                      widths={[260, 400]}
                      sizes="(min-width: 1024px) 18vw, 33vw"
                      class="h-full w-full object-cover grayscale transition-[filter,transform] duration-700 group-hover:scale-105 group-hover:grayscale-0"
                    />
                  </div>
                ))}
                <span class="scan pointer-events-none absolute inset-0 border-l-2 border-accent" />
              </div>
            )}
          </div>

          <div class="flex items-baseline gap-3 border-t border-line px-5 py-4 sm:px-6">
            <span class="font-display text-2xl font-semibold tracking-tight">
              <MetricValue {...m} />
            </span>
            <span class="text-sm text-muted">{m.label}</span>
          </div>

          <span aria-hidden="true" class="feat-rule absolute inset-x-0 bottom-0 h-[2px] bg-accent" />
        </a>
      );
    })
  }
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-reveal] .bar,
    :global(.js) [data-reveal] .tick {
      transform: scaleY(0);
      transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
      transition-delay: calc(200ms + var(--k) * 70ms);
    }
    :global(.js) [data-reveal] .tick {
      transition-delay: calc(200ms + var(--k) * 18ms);
    }
    :global(.js) [data-reveal].is-in .bar,
    :global(.js) [data-reveal].is-in .tick {
      transform: scaleY(1);
    }
    .scan {
      opacity: 0;
    }
    a:hover .scan {
      opacity: 1;
      animation: scan 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    /* The tile settles forward on hover: it lifts onto a tinted shadow, an accent rule
       draws along the bottom edge, and the phone screens fan out one after another. */
    .feat:hover,
    .feat:focus-visible {
      box-shadow: 0 32px 64px -34px rgb(var(--shadow-tint) / 0.5);
    }
    .feat-rule {
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 650ms var(--ease-out-expo);
    }
    .feat:hover .feat-rule,
    .feat:focus-visible .feat-rule {
      transform: scaleX(1);
    }
    .phone {
      transition: transform 750ms var(--ease-out-expo);
      transition-delay: calc(var(--p, 0) * 80ms);
    }
    .feat:hover .phone,
    .feat:focus-visible .phone {
      transform: translateY(-14px) rotate(var(--r, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-rule,
    .phone {
      transition: none;
    }
  }
  @keyframes scan {
    from { transform: translateX(0); }
    to { transform: translateX(100%); }
  }
</style>
