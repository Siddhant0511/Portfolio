---
import { render } from 'astro:content';
import { ArrowLeftIcon, ArrowRightIcon, ArrowUpRightIcon, TrophyIcon } from '@phosphor-icons/react';
import Base from '@/layouts/Base.astro';
import MetricValue from '@/components/case/MetricValue.astro';
import { groups } from '@/lib/site';
import { getWork, resolveLink, workHref, type Work } from '@/lib/work';
import { url } from '@/lib/utils';

export async function getStaticPaths() {
  const work = await getWork();
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: work[i - 1] ?? work[work.length - 1],
      next: work[i + 1] ?? work[0],
    },
  }));
}

interface Props {
  entry: Work;
  prev: Work;
  next: Work;
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);

const meta = [
  { k: 'Role', v: d.role },
  { k: 'Context', v: `${d.org}, ${d.context}` },
  { k: 'Team', v: d.team ?? 'Individual' },
  { k: 'When', v: d.period },
];
---

<Base title={d.title} description={d.summary} image={d.cover?.src}>
  <div class="reading-progress" aria-hidden="true"></div>

  <article>
    <header class="container-x pt-8 pb-14 sm:pt-12 sm:pb-20">
      <a
        href={url('/#work')}
        class="tap-44 group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-ink"
      >
        <ArrowLeftIcon className="size-4 transition-transform group-hover:-translate-x-0.5" aria-hidden="true" />
        All case files
      </a>

      <div class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 sm:mt-14">
        <span class="label !text-accent-ink">{d.fileId}</span>
        <span class="label">{groups[d.group].label}</span>
        {
          d.award && (
            <span class="inline-flex items-center gap-1.5 border border-accent/40 bg-accent-soft px-2 py-1 font-mono text-[11px] tracking-[0.06em] text-accent-ink uppercase">
              <TrophyIcon className="size-3.5" aria-hidden="true" />
              {d.award}
            </span>
          )
        }
      </div>

      <h1
        class="mt-5 max-w-[18ch] text-[clamp(2.6rem,7vw,6rem)] leading-[0.95] tracking-[-0.045em]"
        transition:name={`title-${entry.id}`}
      >
        {d.title}
      </h1>
      <p class="mt-6 max-w-[52ch] text-xl leading-snug text-ink-2 sm:text-2xl">{d.summary}</p>

      <dl class="mt-12 grid grid-cols-1 border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {
          meta.map((m, i) => (
            <div
              class:list={[
                'border-b border-line py-4 sm:pr-6 lg:border-b-0',
                i % 2 === 1 && 'sm:border-l sm:pl-6',
                i === 2 && 'lg:border-l lg:pl-6',
              ]}
            >
              <dt class="label">{m.k}</dt>
              <dd class="mt-2 text-[15px] leading-snug">{m.v}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <section aria-label="Key numbers" class="border-y border-line bg-surface">
      <dl class="container-x grid sm:grid-cols-3">
        {
          d.metrics.map((m, i) => (
            <div
              data-reveal
              style={`--reveal-i:${i}`}
              class:list={['flex flex-col gap-3 py-8 sm:py-10', i > 0 && 'border-t border-line sm:border-t-0 sm:border-l sm:pl-6 lg:pl-8']}
            >
              <dd class="order-1 font-display text-[clamp(2.25rem,4.5vw,3.75rem)] leading-none font-semibold tracking-[-0.045em]">
                <MetricValue {...m} />
              </dd>
              <dt class="order-2 max-w-[28ch] text-sm leading-snug text-ink-2">{m.label}</dt>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="container-x grid gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-10">
      <aside class="hidden lg:col-span-3 lg:block">
        <nav aria-label="On this page" class="sticky top-28">
          <p class="label">On this page</p>
          <ol class="toc relative mt-4 border-l border-line">
            <span data-toc-indicator aria-hidden="true" class="absolute -left-px w-[2px] bg-accent opacity-0"></span>
            {
              toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    class="block py-1.5 pl-4 text-sm text-muted transition-colors hover:text-ink"
                  >
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>

          <div class="mt-10 space-y-5">
            <div>
              <p class="label">Tools and methods</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {d.tools.map((t) => (
                  <li class="border border-line px-2 py-1 text-xs text-ink-2">{t}</li>
                ))}
              </ul>
            </div>
            {
              d.links.length > 0 && (
                <div class="flex flex-col gap-2">
                  {d.links.map((l) => (
                    <a
                      href={resolveLink(l.href)}
                      target="_blank"
                      rel="noopener"
                      class="group flex items-center justify-between bg-ink px-4 py-3 text-sm text-bg transition-colors hover:bg-accent-ink"
                    >
                      {l.label}
                      <ArrowUpRightIcon className="size-4" aria-hidden="true" />
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </nav>
      </aside>

      <div class="min-w-0 lg:col-span-9">
        {
          d.links.length > 0 && (
            <div class="mb-10 flex flex-wrap gap-2 lg:hidden">
              {d.links.map((l) => (
                <a
                  href={resolveLink(l.href)}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 bg-ink px-4 py-3 text-sm text-bg"
                >
                  {l.label}
                  <ArrowUpRightIcon className="size-4" aria-hidden="true" />
                </a>
              ))}
            </div>
          )
        }
        <div class="case-body">
          <Content />
        </div>
      </div>
    </div>

    <nav aria-label="More case files" class="border-t border-line">
      <div class="container-x grid sm:grid-cols-2">
        <a href={workHref(prev)} class="group flex flex-col gap-3 py-10 sm:pr-8">
          <span class="label inline-flex items-center gap-2">
            <ArrowLeftIcon className="size-3.5" aria-hidden="true" /> Previous
          </span>
          <span class="font-display text-2xl font-semibold tracking-[-0.03em] transition-colors group-hover:text-accent-ink sm:text-3xl">
            {prev.data.title}
          </span>
        </a>
        <a href={workHref(next)} class="group flex flex-col items-start gap-3 border-t border-line py-10 sm:items-end sm:border-t-0 sm:border-l sm:pl-8 sm:text-right">
          <span class="label inline-flex items-center gap-2">
            Next <ArrowRightIcon className="size-3.5" aria-hidden="true" />
          </span>
          <span class="font-display text-2xl font-semibold tracking-[-0.03em] transition-colors group-hover:text-accent-ink sm:text-3xl">
            {next.data.title}
          </span>
        </a>
      </div>
    </nav>
  </article>
</Base>

<style>
  .reading-progress {
    position: fixed;
    top: 4rem;
    left: 0;
    right: 0;
    z-index: 49;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      animation: progress linear both;
      animation-timeline: scroll(root);
    }
  }
  @keyframes progress {
    to { transform: scaleX(1); }
  }

  .toc a[aria-current='true'] {
    color: var(--ink);
  }

  /* The contents marker slides to the section you are reading. */
  [data-toc-indicator] {
    transition:
      transform 450ms var(--ease-out-expo),
      height 450ms var(--ease-out-expo),
      opacity 250ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-toc-indicator] {
      transition: none;
    }
  }
</style>

<script>
  function setupToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    if (!links.length) return;
    const targets = [...links]
      .map((l) => document.getElementById(l.dataset.toc!))
      .filter((el): el is HTMLElement => !!el);
    const indicator = document.querySelector<HTMLElement>('[data-toc-indicator]');
    const setActive = (id: string) => {
      links.forEach((l) => l.setAttribute('aria-current', String(l.dataset.toc === id)));
      const current = [...links].find((l) => l.dataset.toc === id);
      if (current && indicator) {
        indicator.style.height = `${current.offsetHeight}px`;
        indicator.style.transform = `translateY(${current.offsetTop}px)`;
        indicator.style.opacity = '1';
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-20% 0px -65% 0px' },
    );
    targets.forEach((t) => io.observe(t));
    if (targets[0]) setActive(targets[0].id);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', setupToc);
</script>
